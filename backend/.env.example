# MongoDB Atlas connection string (leave empty locally to use in-memory storage)
MONGODB_URI=
MONGODB_DB=portfolio
# Comma-separated frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
# Secret for GET /api/messages (send as X-Admin-Key header)
ADMIN_KEY=change-me
# Email every contact/requirement form to you. Use ONE of these:
#  a) Resend (works on Render free): sign up at resend.com with NOTIFY_EMAIL, create an API key.
RESEND_API_KEY=
#  b) Gmail: SMTP_USER=your Gmail, SMTP_PASSWORD=a Google "app password" (may be blocked on Render free).
SMTP_USER=
SMTP_PASSWORD=
# Where enquiries are sent
NOTIFY_EMAIL=manishkaiwarty@gmail.com
# Claude API key for the Ask AI chat (https://console.anthropic.com). Empty = chat replies "not switched on yet".
ANTHROPIC_API_KEY=
# Optional: model for the chat (default claude-opus-5-5) and how many questions it answers per day, site-wide.
CHAT_MODEL=claude-opus-5-5
CHAT_DAILY_CAP=400
